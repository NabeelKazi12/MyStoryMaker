# Observabilidad en Langfuse. Este fichero esta en .gitignore: las claves no
# se versionan. La plantilla sin secretos es .env.example.
LANGFUSE_HOST=https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-TU_CLAVE_PUBLICA
LANGFUSE_SECRET_KEY=sk-lf-TU_CLAVE_SECRETA

# Etiqueta el entorno de las trazas: separa las pruebas de la produccion real.
LANGFUSE_TRACING_ENVIRONMENT=default

# Quien figura como autor de la traza.
LANGFUSE_USER_ID=autor

# Un span por cada llamada a herramienta. Fiel, pero ruidoso y con un proceso
# de python por herramienta usada: ponlo a 0 si prefieres solo los subagentes.
LANGFUSE_TRAZAR_HERRAMIENTAS=1

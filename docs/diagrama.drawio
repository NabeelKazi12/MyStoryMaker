  <diagram id="novela-orquestada" name="Novela agéntica · contratos y memoria">
    <mxGraphModel dx="1400" dy="1500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2339" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;MyStiryMaker · flujo agéntico con contratos de entrada/salida y memoria de ficheros&lt;/b&gt;" style="text;html=1;align=center;fontSize=16;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="1300" height="30" as="geometry" />
        </mxCell>

        <mxCell id="memzone" value="&lt;b&gt;M1 · ESPACIO DE MEMORIA DE FICHEROS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Todo el estado del sistema vive aquí. Versionado en git.&lt;/font&gt;" style="rounded=0;html=1;fillColor=#fdfaf0;strokeColor=#d6b656;dashed=1;verticalAlign=top;align=center;spacingTop=8;fontSize=12;fontColor=#997a00;" vertex="1" parent="1">
          <mxGeometry x="900" y="150" width="440" height="860" as="geometry" />
        </mxCell>

        <mxCell id="orq" value="&lt;b&gt;AGENTE ORQUESTADOR&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;b&gt;IN:&lt;/b&gt; outline.json (estado) + resultado del agente anterior&lt;br&gt;&lt;br&gt;&lt;b&gt;OUT:&lt;/b&gt; invocación del siguiente agente + escritura en memoria&lt;br&gt;&lt;br&gt;&lt;b&gt;Responsabilidades:&lt;/b&gt;&lt;br&gt;· Decide el siguiente paso&lt;br&gt;· Cuenta iteraciones por capítulo&lt;br&gt;· Aplica el umbral de la rúbrica&lt;br&gt;· Consolida en memoria&lt;br&gt;· Escala al autor&lt;br&gt;· Controla coste y presupuesto&lt;br&gt;&lt;br&gt;&lt;b&gt;Condición de salida:&lt;/b&gt;&lt;br&gt;outline.json sin capítulos pendientes, o presupuesto agotado, o escalado abierto&lt;br&gt;&lt;br&gt;&lt;i&gt;Es el único componente que escribe en memoria.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="240" height="620" as="geometry" />
        </mxCell>

        <mxCell id="n0" value="&lt;b&gt;N0 · BRIEF DEL AUTOR&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;b&gt;IN:&lt;/b&gt; intervención humana&lt;br&gt;&lt;b&gt;OUT:&lt;/b&gt; brief.md&lt;br&gt;&lt;b&gt;Condición de salida:&lt;/b&gt; los 6 campos obligatorios completos (premisa, tono, persona y tiempo, extensión, arco, vetos)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="420" y="150" width="420" height="110" as="geometry" />
        </mxCell>

        <mxCell id="n1" value="&lt;b&gt;N1 · AGENTE INVESTIGACIÓN&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;b&gt;IN:&lt;/b&gt; brief.md + lista de temas obligatorios&lt;br&gt;&lt;b&gt;OUT:&lt;/b&gt; research/*.md con fuentes&lt;br&gt;&lt;b&gt;Condición de salida:&lt;/b&gt; los 6 temas cubiertos (técnica zurdo, reglamento, circuito actual, pesaje, lesiones, contexto) y cada afirmación con fuente o marcada como licencia narrativa&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="420" y="300" width="420" height="140" as="geometry" />
        </mxCell>

        <mxCell id="n2" value="&lt;b&gt;N2 · AGENTE ESCALETA&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;b&gt;IN:&lt;/b&gt; brief.md + research/*.md&lt;br&gt;&lt;b&gt;OUT:&lt;/b&gt; bible.json + outline.json&lt;br&gt;&lt;b&gt;Condición de salida:&lt;/b&gt; suma de palabras dentro del ±10 % del objetivo, muestra de voz definida, cada combate con un problema táctico distinto, y aprobación explícita del autor&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="420" y="480" width="420" height="140" as="geometry" />
        </mxCell>

        <mxCell id="n3" value="&lt;b&gt;N3 · AGENTE ESCRITOR&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;b&gt;IN:&lt;/b&gt; outline.json[N] + bible.json + resúmenes previos + notas de revisión (si es reescritura)&lt;br&gt;&lt;b&gt;OUT:&lt;/b&gt; manuscript/cap-NN.md + hechos duros declarados&lt;br&gt;&lt;b&gt;Condición de salida:&lt;/b&gt; extensión dentro del ±15 %, campo de hechos declarados presente, sin marcadores de trabajo&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="420" y="660" width="420" height="150" as="geometry" />
        </mxCell>

        <mxCell id="n4" value="&lt;b&gt;N4 · AGENTE REVISOR&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;b&gt;IN:&lt;/b&gt; cap-NN.md + bible.json + ledger.json&lt;br&gt;&lt;b&gt;OUT:&lt;/b&gt; reviews/cap-NN.json (5 puntuaciones, notas, hechos nuevos)&lt;br&gt;&lt;b&gt;Condición de salida:&lt;/b&gt; los 5 criterios puntuados y toda nota con ubicación, problema y sugerencia&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">

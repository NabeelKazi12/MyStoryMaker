# Estado y entorno
.env
.chroma/
__pycache__/
*.pyc

# Entregable: se compila desde manuscript/
dist/*
!dist/.gitkeep

# Trazas de ejecucion
logs/*.jsonl
logs/.langfuse-*.json

# Contexto precomputado de los subagentes (scripts/contexto.py). Material
# derivado: se regenera de memory/ y config/ cuando haga falta.
.contexto/

# Cada version de un capitulo y de su revision segun se escriben, para poder
# comparar iteraciones en el panel. Derivado y ruidoso; la novela esta en git.
.iteraciones/

# Temporales de la escritura atomica
memory/.*.tmp

# Panel de control (ui/server.py): plan de N2 a la espera de aprobacion y
# estado local de la UI (aprobacion del manuscrito). Nada de esto es memory/,
# pero tampoco es material de la novela.
ui/pendientes/
ui/estado_ui.json

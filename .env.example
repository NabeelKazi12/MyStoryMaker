# Copia este fichero a `.env` y rellena los valores. `.env` esta en .gitignore: aqui no
# hay ni puede haber ninguna clave real.

# --- Modelo -------------------------------------------------------------------------
# El modelo lo fija D-17 (architecture.md 5.1) y no se cambia por variable de entorno:
# bajar de modelo en silencio es lo que D-08 prohibe. Aqui solo va la credencial.
ANTHROPIC_API_KEY=sk-ant-TU_CLAVE_AQUI

# --- Base de datos ------------------------------------------------------------------
MYSTORYMAKER_DB=./canon.db

# --- Observabilidad (fase D) --------------------------------------------------------
# Si no se rellenan, el sistema usa ClienteNulo y sigue funcionando: el observador nunca
# es punto unico de fallo.
LANGFUSE_PUBLIC_KEY=pk-lf-TU_CLAVE_AQUI
LANGFUSE_SECRET_KEY=sk-lf-TU_CLAVE_AQUI
LANGFUSE_HOST=https://cloud.langfuse.com

# --- API ----------------------------------------------------------------------------
# CORS por lista explicita, nunca comodin (RC-08).
MYSTORYMAKER_ORIGENES=http://localhost:5173

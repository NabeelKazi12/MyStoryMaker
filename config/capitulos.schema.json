{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mystorymaker.local/capitulos.schema.json",
  "title": "Plan de capitulos · SPECS §12",
  "type": "object",
  "required": [
    "version",
    "titulo_trabajo",
    "extension",
    "capitulos"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "titulo_trabajo": {
      "type": "string",
      "minLength": 1
    },
    "extension": {
      "type": "object",
      "required": [
        "unidad"
      ],
      "additionalProperties": false,
      "properties": {
        "unidad": {
          "enum": [
            "lineas",
            "palabras"
          ]
        },
        "lineas_totales_objetivo": {
          "type": "integer",
          "minimum": 1
        },
        "tolerancia_capitulo_lineas": {
          "type": "integer",
          "minimum": 0
        },
        "tolerancia_total_lineas": {
          "type": "integer",
          "minimum": 0
        },
        "palabras_totales_objetivo": {
          "type": "integer",
          "minimum": 1
        },
        "tolerancia_capitulo_pct": {
          "type": "number",
          "minimum": 0
        },
        "tolerancia_total_pct": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pov": {
          "type": "string"
        },
        "lineas_objetivo": {
          "type": "integer",
          "minimum": 1
        },
        "palabras_objetivo": {
          "type": "integer",
          "minimum": 1
        },
        "parrafos_objetivo": {
          "type": "integer",
          "minimum": 1
        },
        "lineas_por_parrafo": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "capitulos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "n",
          "acto",
          "contiene_combate"
        ],
        "additionalProperties": false,
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 1
          },
          "acto": {
            "enum": [
              1,
              2,
              3
            ]
          },
          "titulo": {
            "type": "string"
          },
          "lineas_objetivo": {
            "type": "integer",
            "minimum": 1
          },
          "palabras_objetivo": {
            "type": "integer",
            "minimum": 1
          },
          "pov": {
            "type": "string"
          },
          "contiene_combate": {
            "type": "boolean"
          },
          "parrafos_objetivo": {
            "type": "integer",
            "minimum": 1
          },
          "lineas_por_parrafo": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
